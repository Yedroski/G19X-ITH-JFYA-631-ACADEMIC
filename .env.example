# Copia este archivo como .env y cambia el servidor por tu instancia.
# TrustServerCertificate=yes solo para desarrollo local con certificado autofirmado.
SQLSERVER_ODBC="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=SistemaCalidadDatos;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes"
